# Virtual environment
.venv/

# Python cache
__pycache__/
*.py[cod]
*.egg-info/
*.egg

# Application runtime state and logs
.state/
patro.log
scribe.log

# Generated e2e report and raw LLM output (see test/e2e/report_test.go, test/e2e/summary_test.go)
test/e2e/summary_report.md
test/e2e/output/

# Generated knowledge library (user content)
knowledge/

# Local QA config (see docs/regenerate-qa-runbook.md)
config.qa.yaml

# Local dev config (generated by `patro init`; see config.example.yaml)
config.yaml

# Environment files
.env

# IDE
.vscode/
.idea/

# Built binary
/patro

# embedbench dev-tool build artifact (nested module, never released)
/tools/embedbench/embedbench

# GoReleaser output
/dist/

# Test coverage output
coverage.out

# Local tooling metadata (gentle-ai, CodeGraph)
.atl/
.codegraph/

# Analyzer prompts, authored and versioned in Langfuse — fetched by
# tools/promptsync before any build (see .github/workflows/ci.yml and
# release.yml). Required by internal/analyzer's go:embed directives, so a
# fresh checkout cannot `go build` until promptsync has run.
/internal/analyzer/prompt_template.txt
/internal/analyzer/response_schema.json
/internal/analyzer/prompt_fragments/*.txt

# Generated quality reports
/artifacts/quality/
